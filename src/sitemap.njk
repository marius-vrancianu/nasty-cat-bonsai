---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
{#- <lastmod> only where a date means something: posts (front matter) and the
    blog index (newest post). Other pages would get the checkout time — "today"
    on every deploy. Sorted by URL so every build writes the same file. -#}
<?xml version="1.0" encoding="utf-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for item in collections.all | sort(false, true, "url") %}
{%- if item.url and item.url != "/404.html" %}
  <url>
    <loc>{{ site.url }}{{ item.url }}</loc>
    {%- if item.data.tags and "posts" in item.data.tags %}
    <lastmod>{{ item.date | rfc3339 }}</lastmod>
    {%- elif item.url == "/blog/" and collections.posts.length %}
    <lastmod>{{ collections.posts[0].date | rfc3339 }}</lastmod>
    {%- endif %}
  </url>
{%- endif %}
{%- endfor %}
</urlset>
