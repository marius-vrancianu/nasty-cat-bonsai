---
title: Gallery
layout: layouts/page.njk
permalink: /gallery/
---
<h1 class="page-title">Gallery</h1>

{% if gallery.length %}
{#- Per-tree filter: our own button + listbox (see gallery.js for why not a
    <select>). gallery.js fills it from the manifest's `trees` and reveals it;
    without JS or `trees` values the whole gallery simply shows. #}
<div class="gallery-filter" hidden>
  <div class="tree-filter">
    <span class="visually-hidden" id="tree-filter-hint">Filter photos by tree:</span>
    <button type="button" class="tree-filter-button" id="tree-filter-button"
            aria-haspopup="listbox" aria-expanded="false"
            aria-controls="tree-filter-list"
            aria-labelledby="tree-filter-hint tree-filter-value">
      <span class="tree-filter-value" id="tree-filter-value">All trees</span>
      <svg class="tree-filter-chevron" width="12" height="8" viewBox="0 0 12 8"
           aria-hidden="true" focusable="false">
        <path d="M1 1.5l5 5 5-5" fill="none" stroke="currentColor"
              stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
    <ul class="tree-filter-list" id="tree-filter-list" role="listbox"
        aria-label="Filter photos by tree" hidden></ul>
  </div>
</div>

{#- Card href: the largest lightbox copy ("open in new tab", no JS). The
    <img> is a thumbnail carrying the lightbox srcset as data-lb-srcset; see
    galleryThumb / galleryHref in eleventy.config.js. #}
<div id="gallery" class="gallery-grid" data-lb-sizes="{{ lightboxSizes }}">
  {%- for item in gallery %}
  <a class="gallery-card" href="{% galleryHref item %}">
    {% galleryThumb item, loop.index0 %}
    <div class="gallery-card-caption">
      <div class="gallery-card-species">{{ item.species }}</div>
      <div class="gallery-card-meta">{{ item.style }} · {{ item.date }}</div>
    </div>
  </a>
  {%- endfor %}
</div>

{#- "Show more": gallery.js reveals cards already in the HTML a batch at a
    time (hidden cards' lazy images are never fetched). Without JS nothing is
    hidden. Ships hidden; gallery.js reveals it when needed. #}
<div class="gallery-more" hidden>
  <button type="button" class="gallery-more-button">Show more</button>
  <p class="gallery-more-count" role="status"></p>
</div>

{# The manifest (trimmed by the lightboxItems filter) for the lightbox's
    captions, so gallery.js never re-fetches it. "</" is escaped so no text can
    close this script block. #}
<script type="application/json" id="gallery-data">{{ gallery | lightboxItems | dump | replace("</", "<\\/") | safe }}</script>
<script src="/assets/js/gallery.js" defer></script>
{% else %}
<p class="gallery-status">The gallery couldn’t be loaded when this version
of the site was built — it will be back with the next deploy.</p>
{% endif %}
