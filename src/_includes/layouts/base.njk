<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <script>try{if(localStorage.getItem("theme")==="dark")document.documentElement.dataset.theme="dark"}catch(e){}</script>
  {#- Sets --device-px: one device pixel, in CSS px, rounded to a whole number
      of device pixels, so the narrow home layout's brush underlines (7 device
      px) keep the same weight at any zoom — a plain px width snaps unevenly
      when a CSS pixel is not a whole number of device pixels. Inline, before
      the stylesheet, so nothing paints at the wrong weight; CSS falls back to
      1px. #}
  <script>(function(){var r=document.documentElement;function s(){var d=window.devicePixelRatio||1;r.style.setProperty("--device-px",(Math.round(d)||1)/d+"px")}s();addEventListener("resize",s)})()</script>
  {#- One capturing listener sees every image's load/error (they do not
      bubble, but can be caught on the way down), before any <img> is parsed:
        load   frame gets is-loaded; the photo fades in over its --tone
        error  frame gets .missing: hatched box + data-file label
      After parsing, already-complete photos are marked too, so none can stay
      hidden. js-img lets the CSS hold photos back only when this script runs. #}
  <script>(function(d){d.documentElement.classList.add("js-img");function f(e){var t=e.target,p=t&&t.tagName==="IMG"&&t.parentElement;if(p&&p.classList.contains("cdn-frame"))p.classList.add(e.type==="load"?"is-loaded":"missing")}d.addEventListener("load",f,true);d.addEventListener("error",f,true);d.addEventListener("DOMContentLoaded",function(){[].forEach.call(d.querySelectorAll(".cdn-frame img"),function(i){if(i.complete&&i.naturalWidth)i.parentElement.classList.add("is-loaded")})})})(document)</script>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {#- Tints mobile browser chrome to match the paper. theme.js swaps the
      value when the visitor toggles dark mode (values mirror --washi). #}
  <meta name="theme-color" content="#e3dbca">
  <title>{% if title %}{{ title }} — {{ site.name }}{% else %}{{ site.name }}{% endif %}</title>
  <meta name="description" content="{{ description or site.description }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  {#- Share-preview cards (Open Graph + Twitter). Posts use a copy of their
      thumb and their excerpt (ogImage shortcode); other pages use the hero and
      the site description. URLs must be absolute. #}
  {%- set isPost = tags and "posts" in tags %}
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:type" content="{{ "article" if isPost else "website" }}">
  <meta property="og:title" content="{{ title or site.name }}">
  <meta property="og:description" content="{{ description or excerpt or site.description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  {%- if thumb %}
  {% ogImage thumb %}
  {%- else %}
  <meta property="og:image" content="{{ site.url }}/assets/img/hero.jpg">
  <meta property="og:image:width" content="1134">
  <meta property="og:image:height" content="1286">
  {%- endif %}
  {%- if isPost %}
  <meta property="article:published_time" content="{{ page.date | rfc3339 }}">
  {%- endif %}
  <meta name="twitter:card" content="summary_large_image">
  {#- No preconnect: every image is served from this origin (build-cut copies),
      and nothing third-party loads until analytics are accepted. #}
  <link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
  {#- Preload the body font in parallel with the CSS (shorter flash of
      fallback Georgia). `crossorigin` is required even same-origin, or the
      browser fetches it twice. #}
  <link rel="preload" href="/assets/fonts/proza-libre-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/css/main.css">
  <link rel="alternate" type="application/atom+xml" title="{{ site.name }}" href="/feed.xml">
</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>
{{ content | safe }}
{% include "partials/consent-banner.njk" %}
<script src="/assets/js/theme.js" defer></script>
{%- if site.analytics.gaMeasurementId %}
<script src="/assets/js/consent.js" defer></script>
{%- endif %}
</body>
</html>
