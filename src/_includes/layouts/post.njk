---
layout: layouts/base.njk
---
<div class="page">
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header">
    <a class="back-link" href="/blog/">&larr; blog</a>
    {% include "partials/theme-toggle.njk" %}
  </header>
  <main id="main" tabindex="-1" class="page-main">
    <article class="post">
      <div class="post-date">{{ page.date | readableDate }}</div>
      <h1 class="post-title">{{ title }}</h1>
      {%- set ptags = tags | displayTags %}
      {%- if ptags.length %}
      <div class="post-tags">
        {%- for t in ptags %}
        <a class="tag-chip" href="/blog/#tag={{ t | urlencode }}">{{ t }}</a>
        {%- endfor %}
      </div>
      {%- endif %}
      {{ content | safe }}

      {# Comments: our own worker (comments-worker/), switched on by
          comments.apiUrl in src/_data/site.js. The form is in the HTML so the
          section is complete at first paint; comments.js inserts the thread above
          it. #}
      {% if site.comments.apiUrl %}
      <section class="comments" aria-label="Comments"
               data-comments
               data-api="{{ site.comments.apiUrl }}"
               data-post="{{ page.url }}"
               data-post-title="{{ title }}">
        <h2 class="comments-title">Comments</h2>

        <ol class="comment-list" hidden></ol>
        <p class="comment-note" role="status" aria-live="polite"></p>

        <form class="comment-form" novalidate>
          <p class="comment-replying" hidden>
            Replying to <span class="comment-replying-to"></span>
            <button type="button" class="comment-cancel-reply">cancel</button>
          </p>

          <div class="comment-row">
            <label class="comment-field">
              <span>Name</span>
              <input type="text" name="nick" maxlength="40" required autocomplete="nickname">
            </label>
            <label class="comment-field">
              <span>Email <em>(optional)</em></span>
              <input type="email" name="email" maxlength="160" autocomplete="email">
              <small>Only so I can write back to you personally. Never shown here, never shared,
                never added to any list, stored encrypted and deleted after 90 days.</small>
            </label>
          </div>

          <label class="comment-field">
            <span>Comment</span>
            <textarea name="text" rows="5" maxlength="2000" required></textarea>
          </label>

          {#- The honeypot. Hidden from people by CSS and from screen readers
              by aria-hidden; anything that fills it in is a bot. #}
          <div class="comment-hp" aria-hidden="true">
            <label>Website<input type="text" name="website" tabindex="-1" autocomplete="off"></label>
          </div>

          <div class="comment-actions">
            <button type="submit" class="comment-submit">Post comment</button>
            <span class="comment-hint">Comments are moderated before they appear.</span>
          </div>
        </form>

        <noscript>
          <p class="comment-note">Comments need JavaScript to load. Everything else on this page does not.</p>
        </noscript>
      </section>
      <script src="/assets/js/comments.js" defer></script>
      {% endif %}
    </article>
  </main>
  {% include "partials/footer.njk" %}
</div>
